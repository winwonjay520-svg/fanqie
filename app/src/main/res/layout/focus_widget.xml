<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_name" android:textColor="#355365" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_open" android:textColor="#6689A1" android:textSize="12sp" android:padding="8dp" />
    </LinearLayout>
    <Chronometer android:id="@+id/widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#355365" android:textSize="36sp" android:gravity="center" android:fontFamily="sans-serif-light" />
    <TextView android:id="@+id/widget_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#708693" android:textSize="12sp" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/widget_event" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#708693" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/widget_toggle" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:gravity="center" android:background="@drawable/widget_button" android:text="@string/widget_start" android:textColor="#355365" android:textSize="14sp" />
</LinearLayout>
